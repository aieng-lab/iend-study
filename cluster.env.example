# Site-specific cluster settings for the local sync scripts
# (scripts/rsync_analysis.{sh,ps1}, scripts/rsync_to_slurm.{sh,ps1}).
#
# Copy to `cluster.env` (gitignored) and fill in. This is the ONLY place a
# user name / cluster path lives; everything else derives from it.
#
# Base directory on the cluster that holds gradiend-sae/, gradiend/, slurm-logs/, ...
CLUSTER_USER_DIR=/path/to/workdir
#
# Optional: SSH host alias from ~/.ssh/config (default: slurm)
# REMOTE=slurm
